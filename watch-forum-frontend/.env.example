# Public site origin for canonical, Open Graph, hreflang, and sitemap URLs.
# Both default to https://watchtradingforums.com when unset.
SITE_URL=https://watchtradingforums.com
VITE_SITE_URL=https://watchtradingforums.com

# API used by the SEO server and the build-time sitemap.
# Defaults to https://api.watchtradingforums.com/api
API_BASE_URL=https://api.watchtradingforums.com/api
